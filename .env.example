# ── LLM (pick ONE provider; if both are unset the app runs in mock mode) ──────
# OpenAI
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
# Optional, defaults to claude-3-5-haiku-latest
ANTHROPIC_MODEL=

# Force a provider explicitly ("openai" | "anthropic" | "mock").
# If unset: Anthropic key wins, then OpenAI key, then mock.
LLM_PROVIDER=

# ── Payments (placeholders — checkout is disabled until these are set) ────────
# Razorpay (India, ₹49 / ₹199 one-time)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe (global, $1 / $5 one-time)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── App ────────────────────────────────────────────────────────────────────────
# Free-tier character cap for the brain dump (default 600)
FREE_DUMP_CHAR_LIMIT=600
