# ── LLM (pick ONE provider; if both are unset the app runs in mock mode) ──────
# OpenAI
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
# Optional, defaults to claude-3-5-haiku-latest
ANTHROPIC_MODEL=

# Force a provider explicitly ("openai" | "anthropic" | "mock").
# If unset: Anthropic key wins, then OpenAI key, then mock.
LLM_PROVIDER=

# ── Payments — Lemon Squeezy (the only provider) ──────────────────────────────
# Checkout returns 501 with a clear message until these are set.
# Setup steps are in the README ("Payments — Lemon Squeezy setup").

# API key: Lemon Squeezy dashboard → Settings → API
LEMONSQUEEZY_API_KEY=
# Store ID: Settings → Stores (the numeric ID)
LEMONSQUEEZY_STORE_ID=

# Variant IDs of the four ONE-TIME products you create in the dashboard.
# Find each under Store → Products → (product) → the variant's ID.
# India-priced tiers (₹49 / ₹199 display). If your store is USD-only, leave
# the *_INR vars empty and price the USD variants accordingly (~$0.59/~$2.39);
# the app falls back to the USD variant for India buyers automatically.
LEMONSQUEEZY_VARIANT_SINGLE_INR=
LEMONSQUEEZY_VARIANT_WEEK_INR=
# Global tiers ($1 / $5)
LEMONSQUEEZY_VARIANT_SINGLE_USD=
LEMONSQUEEZY_VARIANT_WEEK_USD=

# Webhook signing secret: Settings → Webhooks → your webhook → Signing secret.
# Point the webhook at https://<your-domain>/api/webhooks/lemonsqueezy
# and subscribe to order_created.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Secret used to sign the stateless unlock tokens/cookies (any long random
# string, e.g. `openssl rand -hex 32`). Falls back to LEMONSQUEEZY_API_KEY if
# unset — but set it, so rotating the API key doesn't kill active passes.
PASS_SIGNING_SECRET=

# ── App ────────────────────────────────────────────────────────────────────────
# Public base URL used for the post-checkout redirect
# (default https://droplist-seven.vercel.app; use http://localhost:3000 locally)
APP_URL=

# Free-tier character cap for the brain dump (default 600)
FREE_DUMP_CHAR_LIMIT=600
